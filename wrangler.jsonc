{
  // Sitio estático servido por Cloudflare Workers (Static Assets).
  // El nombre debe coincidir con el del Worker en el panel de Cloudflare.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finn-capitel",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "."
  },
  // Al declarar rutas, wrangler apaga workers.dev salvo que se indique aquí.
  "workers_dev": true,
  "routes": [
    { "pattern": "finncapitel.com/*", "zone_name": "finncapitel.com" },
    { "pattern": "www.finncapitel.com/*", "zone_name": "finncapitel.com" }
  ]
}
